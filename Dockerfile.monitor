FROM alpine:3.22

ARG KUBECTL_VERSION=v1.35.8

# Install required dependencies
RUN apk add --no-cache bash ca-certificates jq

# Download and install kubectl
RUN wget -q -O /usr/local/bin/kubectl \
        "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" && \
        chmod 0755 /usr/local/bin/kubectl

WORKDIR /monitor

# Add bash script to the image
COPY awk.monitor-app-pods /monitor/awk.monitor-app-pods

# Create a non-root user and Make the script executable
RUN chmod +x /monitor/awk.monitor-app-pods && \
    adduser --disabled-password --uid 1001 monitor && \
    chown -R monitor:monitor /monitor

USER 1001

# Set the default command to run monitoring script
CMD ["/bin/bash", "/monitor/awk.monitor-app-pods"]
